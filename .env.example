# =============================================================================
# RK MEMORY STUDIO - ENVIRONMENT CONFIGURATION
# Copy to `.env.local` for development, and set the same keys in your host's
# environment settings for production. Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.rkmemorystudio.com

# Set to "true" ONLY on the live production site. Anything else serves a
# robots.txt that blocks all crawlers, so staging never gets indexed.
NEXT_PUBLIC_SITE_INDEXABLE=false

# -----------------------------------------------------------------------------
# BUSINESS CONTACT  >>> YOU NEED TO PROVIDE THESE <<<
# Until set, the site shows an honest "coming soon" state instead of a fake
# address. It never displays a placeholder email to customers.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/rkmemorystudio/
NEXT_PUBLIC_FACEBOOK_URL=

# -----------------------------------------------------------------------------
# CHECKOUT  >>> YOU NEED TO PROVIDE THESE <<<
# -----------------------------------------------------------------------------

# Which provider is live: "check-cherry" (default) or "etsy".
# Etsy stays registered but dormant, so opening it as a sales channel later is
# a one-line change here rather than a rewrite.
CHECKOUT_PROVIDER=check-cherry

# --- Check Cherry (ACTIVE) ----------------------------------------------------
# The same system RK 360 Photo Booth Rentals already uses, so both businesses
# share one order inbox. See docs/check-cherry-integration.md.

# "hosted" = send the customer to your Check Cherry booking/checkout page
# "embed"  = render your Check Cherry embed snippet on our /checkout page
# unset    = checkout is off; customers get a contact fallback, not a dead button
CHECK_CHERRY_MODE=

# HOSTED MODE: your public Check Cherry booking/checkout URL (must be https).
CHECK_CHERRY_BOOKING_URL=

# EMBED MODE: the embed snippet from your Check Cherry dashboard, on one line.
CHECK_CHERRY_EMBED_HTML=

# The query parameter Check Cherry receives our order reference in. This MUST
# match a field configured on your Check Cherry booking form, otherwise you
# cannot match an incoming order to its uploaded photos.
CHECK_CHERRY_REFERENCE_PARAM=reference

# Optional extra query params, as key=value&key2=value2
CHECK_CHERRY_EXTRA_PARAMS=

# Optional customer portal URL, used on the /account page.
NEXT_PUBLIC_ORDER_PORTAL_URL=

# --- Etsy (DORMANT) -----------------------------------------------------------
# Only read when CHECKOUT_PROVIDER=etsy. See docs/etsy-integration.md.
# Etsy has NO checkout API and NO buyer file upload, so that path requires the
# customer to paste the order code into Etsy's personalization field.
ETSY_SHOP_URL=
NEXT_PUBLIC_ETSY_SHOP_URL=

# -----------------------------------------------------------------------------
# PHOTO UPLOADS
# -----------------------------------------------------------------------------
# "local" writes to disk - fine for development and for a long-running Node
# server, but NOT for serverless hosting (Vercel/Netlify functions).
# Before launch, implement and select an object-store adapter.
# "demo-discard" ACCEPTS AND THROWS AWAY every file. Use it ONLY to demo the
# flow on a serverless preview. It logs a warning on every upload. Never take
# real orders with it.
UPLOAD_PROVIDER=local

# Directory for the local adapter. Keep it OUTSIDE /public - these are
# customers' personal photographs and must not be publicly served.
UPLOAD_LOCAL_DIR=

# Per-file ceiling in bytes (default 30MB). Public so the browser can
# pre-validate before spending the customer's bandwidth.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=31457280

# -----------------------------------------------------------------------------
# ENQUIRIES (contact form + bulk order quotes)
# -----------------------------------------------------------------------------
# "webhook" = POST the enquiry as JSON to ENQUIRY_WEBHOOK_URL (recommended -
#             works with Zapier, Make, an inbox automation, or your CRM)
# "log"     = write to the server log (development only)
# unset     = form is disabled and tells customers to email instead
ENQUIRY_TRANSPORT=

ENQUIRY_WEBHOOK_URL=

# Optional shared secret, sent as the X-RKMS-Secret header.
ENQUIRY_WEBHOOK_SECRET=
